# Copy this file to .env and fill in your own values. .env is git-ignored; never commit it.

# Required for the AI summary (create at https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional: free NCBI key raises the PubMed rate limit from 3 to 10 requests/second
# (create at https://www.ncbi.nlm.nih.gov/account/settings/)
NCBI_API_KEY=
